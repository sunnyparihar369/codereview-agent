# CodeReview Agent - Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=codereview-agent
ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# GITHUB (choose one auth method)
# =============================================================================

# Option 1: GitHub App (recommended for production)
# Create at: https://github.com/settings/apps
# Permissions: Pull requests (R&W), Contents (R), Metadata (R), Issues (R&W)
# Webhook URL: https://your-domain/webhook/github
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Option 2: Personal Access Token (simpler for development)
# Create at: https://github.com/settings/tokens
# Scopes: repo, admin:repo_hook
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# GITLAB (optional)
# =============================================================================
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat_xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret

# =============================================================================
# LLM PROVIDER (choose one)
# =============================================================================
DEFAULT_LLM_PROVIDER=anthropic  # anthropic, openai, or gemini

# Anthropic (Claude)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
MODEL_SIMPLE=claude-3-5-haiku-20241022
MODEL_COMPLEX=claude-3-5-sonnet-20241022

# OpenAI (GPT)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# MODEL_SIMPLE=gpt-4o-mini
# MODEL_COMPLEX=gpt-4o

# Google (Gemini)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx
# MODEL_SIMPLE=gemini-1.5-flash
# MODEL_COMPLEX=gemini-1.5-pro

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
MAX_FILE_SIZE_KB=100
MAX_FILES_PER_PR=50
MAX_TOTAL_DIFF_TOKENS=50000
REVIEW_TIMEOUT_SECONDS=120

# Specialist agent toggles
ENABLE_SECURITY_AGENT=true
ENABLE_PERFORMANCE_AGENT=true
ENABLE_STYLE_AGENT=true
ENABLE_ARCHITECTURE_AGENT=true
ENABLE_TESTS_AGENT=true
ENABLE_LEARNING_LOOP=false

# Severity thresholds
SECURITY_SEVERITY_THRESHOLD=medium
PERFORMANCE_COMPLEXITY_THRESHOLD=10
STYLE_MAX_LINE_LENGTH=100

# =============================================================================
# LANGSMITH (observability - optional but recommended)
# =============================================================================
# Get key at: https://smith.langchain.com/settings
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=codereview-agent
LANGSMITH_TRACING=true

# =============================================================================
# METRICS (Prometheus)
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Add custom flags here as needed